---
import { getCollection } from 'astro:content';
import PostsList from '../../../../components/PostsList.astro';
import { getPostsByLocale, LOCALES, POSTS_PER_PAGE } from '../../../../utils/i18n';

export async function getStaticPaths() {
  const allPosts = await getCollection('posts');
  const posts = getPostsByLocale(allPosts, LOCALES.ENGLISH);
  const totalPages = Math.ceil(posts.length / POSTS_PER_PAGE);

  return Array.from({ length: totalPages }, (_, i) => ({
    params: { page: (i + 1).toString() },
  }));
}

const { page } = Astro.params;
const currentPage = parseInt(page || '1', 10);

const title = `Posts - Page ${currentPage}`;
const description = `Blog publications list - Page ${currentPage}`;
---

<PostsList
  locale={LOCALES.ENGLISH}
  currentPage={currentPage}
  baseUrl="/en/posts"
  title={title}
  description={description}
  heading="List of publications by date"
/>
